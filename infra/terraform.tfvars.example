# No variables are REQUIRED. Every one has a default, so a tfvars file is optional.
# Point the demo at your own GCP project by overriding project_id (in this file,
# with `-var`, or with `TF_VAR_project_id`). The rest are fine as they are.

# --- Optional overrides (defaults shown) ---

# project_id       = "datacloud-pitwall"
# region           = "us-central1"
# dataset_location = "US"
