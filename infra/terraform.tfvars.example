# No variables are REQUIRED. Every one has a default, so a tfvars file is optional.
# Point the demo at your own GCP project by overriding project_id (in this file,
# with `-var`, or with `TF_VAR_project_id`). The rest are fine as they are.

# --- Optional overrides (defaults shown) ---

# project_id       = "datacloud-pitwall"
# region           = "us-central1"
# dataset_location = "US"

# --- Optional: Google Groups on the data products ---
# Create the groups first. Each one is optional: an owner group replaces the
# default owner, the stewards approve access requests, and each consumer group
# gets read access to the tables of its data products.
#
# data_product_groups = {
#   telemetry_owners = "pitwall-telemetry-owners@example.com" # owns Race Telemetry
#   strategy_owners  = "pitwall-strategy-owners@example.com"  # owns Race Strategy
#   stewards         = "pitwall-data-stewards@example.com"    # approves access requests
#   analysts         = "pitwall-analysts@example.com"         # reads Race Strategy
#   data_scientists  = "pitwall-data-scientists@example.com"  # reads both products
# }
